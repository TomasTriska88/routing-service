a-card>`;

    this.shadowRoot.querySelectorAll("[data-health]").forEach(el => {
      el.addEventListener("click", () => {
        const item = health[Number(el.getAttribute("data-health"))];
        this._moreInfo(item?.entity);
      });
    });
  }

  static getStubConfig() { return { name:"Lina" }; }
}

if (!customElements.get("lina-home-card")) {
  customElements.define("lina-home-card", LinaHomeCard);
}
window.customCards = window.customCards || [];
if (!window.customCards.some(c => c.type === "lina-home-card")) {
  window.customCards.push({
    type:"lina-home-card",
    name:"Lina Home Card",
    description:"TV-first souhrn Linina Hnízda a jeho dostupnosti.",
    preview:true,
  });
}
